# Raw federal data never gets committed. Sample fixtures under
# ingest/sample/ are the exception, capped at a few thousand rows.
data/
*.csv
*.parquet
!ingest/sample/**
!dbt/seeds/*.csv

# Secrets
.env
.aws/
*.key
*.pem
profiles.yml
*.tfvars
!*.tfvars.example

# Terraform
.terraform/
.terraform-offline/
.terraformrc
terraform.rc
backend.hcl
*.tfplan
crash.log
*.tfstate
*.tfstate.*

# IDE
.idea/
.vscode/
*.iml
.worktrees/

# macOS
.DS_Store

# Python
__pycache__/
.venv/
*.egg-info/
.coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
coverage.lcov
target/
dbt_packages/
logs/
