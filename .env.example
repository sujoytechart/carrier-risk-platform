AWS_REGION=us-east-1
CARRIER_RISK_RAW_BUCKET=carrier-risk-raw-your-account-id
CARRIER_RISK_INGEST_ROLE_ARN=arn:aws:iam::your-account-id:role/carrier-risk-ingest-dev
POSTGRES_PASSWORD=set-a-local-development-password
MINIO_ROOT_PASSWORD=set-a-local-development-password
# libpq reads the password from PGPASSWORD or ~/.pgpass.
CARRIER_RISK_DATABASE_URL="host=localhost port=5432 user=carrier_risk dbname=carrier_risk"
CARRIER_RISK_QUEUE_URL=http://localhost:9324/000000000000/carrier-risk-arrivals
CARRIER_RISK_S3_ENDPOINT_URL=http://localhost:9000
CARRIER_RISK_SQS_ENDPOINT_URL=http://localhost:9324
MLFLOW_TRACKING_URI=http://localhost:5000
CARRIER_RISK_MODEL_NAME=carrier-risk-v0
CARRIER_RISK_MODEL_ALIAS=champion

# Optional Snowflake trial target. Set these only when running that target.
# Keep the private key outside the repository; never commit credentials.
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_ROLE=
# SNOWFLAKE_DATABASE=
# SNOWFLAKE_WAREHOUSE=
# DBT_ENV_SECRET_SNOWFLAKE_PRIVATE_KEY_PATH=
# DBT_ENV_SECRET_SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
