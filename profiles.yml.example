carrier_risk_platform:
  target: local
  outputs:
    local:
      type: postgres
      host: "{{ env_var('POSTGRES_HOST', 'localhost') }}"
      port: "{{ env_var('POSTGRES_PORT', '5432') | int }}"
      user: "{{ env_var('POSTGRES_USER', 'carrier_risk') }}"
      password: "{{ env_var('POSTGRES_PASSWORD') }}"
      dbname: "{{ env_var('POSTGRES_DB', 'carrier_risk') }}"
      schema: public
      threads: 4
      connect_timeout: 10
      sslmode: "{{ env_var('POSTGRES_SSLMODE', 'prefer') }}"
